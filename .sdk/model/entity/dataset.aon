# Entity: dataset

main: kit: entity: dataset: {

  alias: field: {}

  fields: [
    {
      name: "description"
      req: false
      short: "Detailed description of the dataset"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "download_url"
      req: false
      short: "URL to download the dataset"
      type: "`$STRING`"
    }
    {
      name: "formats"
      req: false
      short: "Available formats for the dataset"
      type: "`$ARRAY`"
    }
    {
      name: "id"
      req: false
      short: "Unique identifier for the dataset"
      type: "`$STRING`"
    }
    {
      name: "jurisdiction"
      req: false
      short: "Jurisdiction level of the dataset"
      type: "`$STRING`"
    }
    {
      name: "keywords"
      req: false
      short: "Keywords associated with the dataset"
      type: "`$ARRAY`"
    }
    {
      name: "publisher"
      req: false
      short: "Organization that published the dataset"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "record_modified"
      req: false
      short: "Date when the dataset was last modified"
      type: "`$STRING`"
    }
    {
      format: "date"
      name: "record_released"
      req: false
      short: "Date when the dataset was first released"
      type: "`$STRING`"
    }
    {
      name: "resources"
      req: false
      short: "List of resources associated with the dataset"
      type: "`$ARRAY`"
    }
    {
      name: "title"
      req: false
      short: "Title of the dataset"
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "dataset"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "format"
                orig: "format"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "keyword"
                orig: "keyword"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 10
                kind: "query"
                name: "limit"
                orig: "limit"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "organization"
                orig: "organization"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: 1
                kind: "query"
                name: "page"
                orig: "page"
                reqd: false
                type: "`$INTEGER`"
              }
              {
                kind: "query"
                name: "q"
                orig: "q"
                reqd: false
                type: "`$STRING`"
              }
              {
                example: "relevance"
                kind: "query"
                name: "sort"
                orig: "sort"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/opendata/"
          segments: [
            {
              lit: "opendata"
            }
          ]
          select: {
            exist: [
              "format"
              "keyword"
              "limit"
              "organization"
              "page"
              "q"
              "sort"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.results`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "dataset_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/opendata/dataset/{datasetId}"
          rename: {
            param: {
              datasetId: "id"
            }
          }
          segments: [
            {
              lit: "opendata"
            }
            {
              lit: "dataset"
            }
            {
              var: "id"
            }
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
